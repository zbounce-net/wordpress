msgstr "Так"

msgid "No"
msgstr "Ні"

msgid "Not checked"
msgstr "Не перевірено"

msgid "Yes (unreliable)"
msgstr "Так (ненадійно)"

msgid "Server accepts all"
msgstr "Сервер приймає всі адреси"

msgid "Checking…"
msgstr "Перевіряємо…"

msgid "Allowed"
msgstr "Дозволено"

msgid "Rejected"
msgstr "Відхилено"

