msgid "Administrator access required."
msgstr "Потрібен доступ адміністратора."

msgid "Enable external verification and save your API key first."
msgstr "Спочатку увімкніть зовнішню перевірку та збережіть API-ключ."

msgid "Connection failed. Check your API key and try again."
msgstr "Не вдалося підключитися. Перевірте API-ключ і спробуйте знову."

#, php-format
msgid "Connected. Remaining verification credits: %s."
msgstr "Підключено. Залишилося кредитів перевірки: %s."

msgid "Enable ZBounce and enter your purchased API key in Settings first."
msgstr ""
"Спочатку увімкніть ZBounce і введіть придбаний API-ключ у налаштуваннях."

msgid "Invalid email format"
msgstr "Невірний формат електронної пошти"

msgid ""
"ZBounce could not complete this check. Check your key, balance and "
"connection."
msgstr ""
"ZBounce не зміг завершити перевірку. Перевірте ключ, баланс і з’єднання."

#, php-format
msgid "Remaining credits: %s"
msgstr "Залишилося кредитів: %s"

msgid "Balance unavailable. Check your key and connection."
msgstr "Баланс недоступний. Перевірте ключ і з’єднання."

msgid "Valid"
msgstr "Коректна"

msgid "Invalid"
msgstr "Некоректна"

