msgstr "启用 WooCommerce 结账验证"

msgid "Enable WP Registration"
msgstr "启用 WordPress 注册验证"

msgid "Gravity Forms to Validate"
msgstr "要验证的 Gravity Forms"

msgid "WPForms to Validate"
msgstr "要验证的 WPForms"

