msgid "Administrator access required."
msgstr "Administratorzugriff erforderlich."

msgid "Accept the agreement and save your API key first."
msgstr ""
"Akzeptieren Sie die Vereinbarung und speichern Sie zuerst Ihren API-"
"Schlüssel."

msgid "Connection failed. Check your API key and try again."
msgstr ""
"Verbindung fehlgeschlagen. Prüfen Sie Ihren API-Schlüssel und versuchen Sie "
"es erneut."

#, php-format
msgid "Connected. Remaining verification credits: %s."
msgstr "Verbunden. Verbleibende Prüfguthaben: %s."

msgid ""
"Accept the agreement and save your purchased API key in Settings first."
msgstr ""
"Akzeptieren Sie die Vereinbarung und speichern Sie Ihren gekauften API-"
"Schlüssel in den Einstellungen."

msgid "Invalid email format"
msgstr "Ungültiges E-Mail-Format"

msgid ""
"ZBounce could not complete this check. Check your key, balance and "
"connection."
msgstr ""
"ZBounce konnte diese Prüfung nicht abschließen. Prüfen Sie Schlüssel, "
"Guthaben und Verbindung."

#, php-format
msgid "Remaining credits: %s"
msgstr "Verbleibendes Guthaben: %s"

msgid "Balance unavailable. Check your key and connection."
msgstr "Guthaben nicht verfügbar. Prüfen Sie Schlüssel und Verbindung."

