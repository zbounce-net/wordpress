msgid "Administrator access required."
msgstr "Требуется доступ администратора."

msgid "Enable external verification and save your API key first."
msgstr "Сначала включите внешнюю проверку и сохраните API-ключ."

msgid "Connection failed. Check your API key and try again."
msgstr "Не удалось подключиться. Проверьте API-ключ и попробуйте снова."

#, php-format
msgid "Connected. Remaining verification credits: %s."
msgstr "Подключено. Осталось кредитов проверки: %s."

msgid "Enable ZBounce and enter your purchased API key in Settings first."
msgstr "Сначала включите ZBounce и укажите купленный API-ключ в настройках."

msgid "Invalid email format"
msgstr "Неверный формат email"

msgid ""
"ZBounce could not complete this check. Check your key, balance and "
"connection."
msgstr ""
"ZBounce не смог завершить проверку. Проверьте ключ, баланс и соединение."

#, php-format
msgid "Remaining credits: %s"
msgstr "Осталось кредитов: %s"

msgid "Balance unavailable. Check your key and connection."
msgstr "Баланс недоступен. Проверьте ключ и соединение."

